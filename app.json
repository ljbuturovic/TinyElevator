{
  "expo": {
    "name": "TinyElevator",
    "slug": "TinyElevator",
    "scheme": "tinyelevator",
    "platforms": [
      "ios"
    ],
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/tinyelevator-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ljubomirbuturovic.tinyelevator",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TinyElevator to copy selected photos into the app."
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e2e73b2a-b962-4f31-a857-5613ad46ed45"
      }
    }
  }
}
